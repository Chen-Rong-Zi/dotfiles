#!/usr/bin/bash

shot_name=$(get_shot_path)
shot_path=$shot_dir/$shot_name

noti_id=$(timeout 8 $notify -p -t 2000 --hint string:app_icon:/usr/share/swcatalog/icons/archlinux-arch-extra/48x48/spectacle_spectacle.png "截图" "选择窗口或框出一个矩形")
maim -m 6 -f png -s $shot_path

if [[ -f "$shot_path" ]];then
    echo "$shot_path" | gpaste-client add
    timeout 8 $notify -p -r "$noti_id" -t 5000 --hint string:app_icon:/usr/share/swcatalog/icons/archlinux-arch-extra/48x48/spectacle_spectacle.png -A "ocr:$((noti_id+1)):$shot_path=识别" "保存为" "$shot_name"

    for id in $(kdeconnect-cli -a | grep -Po '(?<=^-.{,100}: ).[^[:blank:]]*');do
        kdeconnect-cli -d "$id" --share "$shot_path" &
        $notify -t 1800 --hint string:app_icon:/usr/share/swcatalog/icons/archlinux-arch-extra/48x48/spectacle_spectacle.png  "发送到" "$id"
    done

else
    timeout 8 $notify -p -t 3000 --hint string:app_icon:$error_icon "选择无效！"
fi
